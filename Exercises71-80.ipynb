   "source": [
    "## Exercise 71:\n",
    "\n",
    "Given an array as a list, convert it to float with reversed order."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "ce503869-fc1b-49d2-849b-a807ea003344",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "['2', '4', '6', '-3', '9']"
      ]
     },
     "execution_count": 22,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "ah = \"2 4 6 -3 9\"\n",
    "arr = ah.strip().split(\" \")\n",
    "arr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "bbe40efd-e8d4-4366-bff9-c3c5a484f3ca",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([ 9., -3.,  6.,  4.,  2.])"
      ]
     },
     "execution_count": 27,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "def arrays(arr):\n",
    "    a = np.array(arr, float)\n",
    "    a = np.flip(a)\n",
    "    return a\n",
    "\n",
    "arrays(arr)"
   ]
  },
